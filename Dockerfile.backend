FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend .
# Bake the trained model into the image so the first API request is instant and
# the running container never needs to train. Artifacts land in /app/model/.
RUN python -m app.ml.train_xgboost --quiet
EXPOSE 8000
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000"]
